{
  "expo": {
    "name": "Makola",
    "slug": "makola-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.makola.mobile"
    },
    "android": {
      "package": "com.makola.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Makola uses your location to show your current area."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Makola uses your photos to let you set a profile picture, add listing photos, and upload verification documents.",
          "cameraPermission": "Makola uses your camera to take listing photos and verification selfies."
        }
      ],
      "@rnmapbox/maps"
    ],
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "extra": {
      "eas": {
        "projectId": "06a134ee-e4cd-4b2c-b54d-216008f2ae0f"
      }
    }
  }
}
